{
  "name": "@lacspace/analytics",
  "version": "2.0.1",
  "description": "Event tracking for Lacspace platforms — batching and an offline queue.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lacspace",
    "analytics",
    "tracking",
    "events",
    "typescript"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "MIT",
  "homepage": "https://lacspace.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "analytics"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@lacspace/api": "^2.0.0"
  }
}
