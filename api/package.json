{
  "name": "@lacspace/api",
  "version": "2.2.0",
  "description": "Lightweight, zero-dependency, isomorphic TypeScript HTTP client for Lacspace APIs — retries, interceptors, pagination, plus query/URL/header/form/error helpers.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lacspace",
    "api",
    "http-client",
    "fetch",
    "isomorphic",
    "typescript",
    "rest-client",
    "http",
    "request",
    "retry",
    "interceptors",
    "pagination",
    "axios-alternative",
    "ky-alternative",
    "fetch-wrapper",
    "query-string",
    "querystring",
    "url-join",
    "cursor-pagination",
    "form-urlencoded",
    "merge-headers",
    "abortsignal",
    "backoff"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "api"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
