{
  "name": "@lacspace/audit-log",
  "version": "1.1.0",
  "description": "Structured audit-trail toolkit — record who did what, when, with before/after diffs, actor attribution and field-level redaction, plus a tamper-evident SHA-256 hash chain that proves the log was not altered. Zero-dependency, isomorphic (Node 20+, edge, modern browsers).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "audit-log",
    "audit-trail",
    "activity-log",
    "event-log",
    "who-did-what",
    "attribution",
    "diff",
    "redact",
    "compliance",
    "tamper-evident",
    "hash-chain",
    "immutable",
    "isomorphic",
    "zero-dependency",
    "typescript"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/audit-log",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "audit-log"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
