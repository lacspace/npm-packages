{
  "name": "@lacspace/auth",
  "version": "2.1.1",
  "description": "Authentication flows (login, register, token, refresh) for Lacspace APIs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lacspace",
    "auth",
    "authentication",
    "login",
    "jwt",
    "typescript",
    "authorization",
    "token-refresh",
    "session",
    "access-token",
    "refresh-token",
    "auth-client",
    "auto-refresh"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://lacspace.com/packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "auth"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@lacspace/api": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
