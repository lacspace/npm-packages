{
  "name": "@lacspace/chunk",
  "version": "1.1.0",
  "description": "A tiny, zero-dependency text splitter for RAG and long-context prompts — recursive character, Markdown, code, sentence and paragraph chunking with overlap, batch document chunking, small-chunk merging and a pluggable token-aware lengthFn (with a built-in approximate token counter). Isomorphic and fully typed.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "chunk",
    "text-splitter",
    "chunking",
    "rag",
    "retrieval",
    "embeddings",
    "recursive-character-text-splitter",
    "markdown-splitter",
    "code-splitter",
    "ai",
    "llm",
    "prompt-engineering",
    "tokenizer",
    "token-counter",
    "merge-chunks",
    "split-documents",
    "document-chunking",
    "vector-database",
    "semantic-search",
    "typescript",
    "zero-dependency",
    "isomorphic"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/chunk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "chunk"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
