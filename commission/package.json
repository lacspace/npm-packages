{
  "name": "@lacspace/commission",
  "version": "1.1.0",
  "description": "Commission & payout calculation engine — flat, percentage, marginal-tier and progressive-slab rules with min/cap, composite & per-category rates, tax on commission, explicit rounding modes, plus a conserving marketplace split (platform take-rate + seller + affiliate). Integer minor units, zero floats. Isomorphic (Node, edge, browser).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "commission",
    "payout",
    "marketplace",
    "sales-commission",
    "tiered",
    "slab",
    "take-rate",
    "percentage",
    "revenue-share",
    "split",
    "marketplace-split",
    "composite",
    "tax",
    "gst",
    "rounding",
    "bankers-rounding",
    "minor-units",
    "fintech",
    "isomorphic",
    "typescript"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/commission",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "commission"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
