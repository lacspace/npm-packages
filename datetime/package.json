{
  "name": "@lacspace/datetime",
  "version": "1.1.0",
  "description": "Immutable date-time toolkit — arithmetic, start/end of unit, diff & breakdown, comparison, relative-time, business days, calendar grid, token format/parse and ISO. Zero-dependency, isomorphic, a tiny date-fns/dayjs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "date",
    "time",
    "datetime",
    "date-fns",
    "dayjs",
    "moment",
    "immutable",
    "add",
    "subtract",
    "diff",
    "format",
    "parse",
    "startOf",
    "endOf",
    "relative-time",
    "time-ago",
    "business-days",
    "working-days",
    "holidays",
    "calendar",
    "calendar-grid",
    "weekday",
    "iso8601",
    "rfc3339",
    "leap-year",
    "zero-dependency",
    "isomorphic",
    "typescript"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/datetime",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "datetime"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
