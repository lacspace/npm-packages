{
  "name": "@lacspace/duration",
  "version": "1.1.0",
  "description": "A zero-dependency, isomorphic Duration type — parse, build, normalize and do arithmetic on ISO-8601 time spans. Calendar-honest about months & years.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "duration",
    "iso8601",
    "iso-8601",
    "parse-duration",
    "time-span",
    "interval",
    "period",
    "date-math",
    "temporal",
    "immutable",
    "zero-dependency",
    "isomorphic",
    "typescript",
    "humanize-duration",
    "format-duration",
    "hh-mm-ss",
    "clock",
    "clamp",
    "rebalance"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/duration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "duration"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
