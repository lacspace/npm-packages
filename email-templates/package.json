{
  "name": "@lacspace/email-templates",
  "version": "1.1.0",
  "description": "Compose bulletproof, responsive, dark-mode-aware HTML emails from simple blocks — buttons, OTP codes, invoices — with ready-made OTP/welcome/verify/password-reset/magic-link/order/shipping/invitation/digest/announcement templates, plaintext generation, preheaders and {{var}} i18n interpolation. Zero-dependency, isomorphic.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "email-template",
    "html-email",
    "responsive-email",
    "transactional-email",
    "email-builder",
    "otp-email",
    "invoice-email",
    "mjml-alternative",
    "typescript",
    "email-html",
    "dark-mode-email",
    "email-components",
    "password-reset-email",
    "magic-link-email",
    "react-email-alternative",
    "email-to-plaintext",
    "email-preheader",
    "verify-email",
    "order-confirmation-email",
    "shipping-email",
    "invitation-email",
    "digest-email",
    "email-i18n"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/email-templates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "email-templates"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
