{
  "name": "@lacspace/id",
  "version": "1.1.0",
  "description": "Every ID kind you need — UUID v4/v7, ULID, cuid2, Snowflake, Nano-ID, base62/base58 and Stripe-style prefixed ids. Custom alphabets with unbiased sampling, time-sortable + decodeTime. Cryptographically random (Web Crypto), zero-dependency, isomorphic.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "uuid",
    "uuidv4",
    "uuidv7",
    "uuid-v7",
    "ulid",
    "cuid2",
    "snowflake",
    "snowflake-id",
    "nanoid",
    "base62",
    "base58",
    "prefixed-id",
    "custom-alphabet",
    "short-id",
    "unique-id",
    "id-generator",
    "time-sortable",
    "sortable-id",
    "decode-time",
    "web-crypto",
    "csprng",
    "zero-dependency",
    "isomorphic",
    "typescript"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "id"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
