{
  "name": "@lacspace/jwt",
  "version": "1.4.0",
  "description": "JSON Web Tokens (HS/RS/ES/EdDSA) with JWKS-by-kid key rotation, strict expiry/issuer/audience/subject/jti checks + secure random & CSRF tokens. Isomorphic over Web Crypto — Node, edge, browser.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "jwt",
    "jsonwebtoken",
    "hs256",
    "token",
    "auth",
    "csrf",
    "web-crypto",
    "edge",
    "typescript",
    "jose",
    "rs256",
    "es256",
    "hs384",
    "hs512",
    "jwks",
    "refresh-token",
    "token-rotation",
    "sign",
    "eddsa",
    "ed25519",
    "es384",
    "es512",
    "jwk",
    "keyset",
    "key-rotation",
    "clock-tolerance",
    "oidc"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/jwt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "jwt"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lacspace/crypto": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
