{
  "name": "lacspace-changelog",
  "version": "0.1.0",
  "description": "Turn Conventional Commits into a grouped CHANGELOG.md, compute the next semver bump and print release notes — keyless and local. Zero dependencies.",
  "type": "module",
  "bin": {
    "lacspace-changelog": "dist/cli.js"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "changelog", "conventional-commits", "semver", "semver-bump", "release",
    "release-notes", "keep-a-changelog", "version-bump", "changelog-generator",
    "git", "cli", "typescript", "commit-parser", "release-please",
    "standard-version", "monorepo", "prerelease", "ci", "automation",
    "zero-dependency"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/tools/changelog",
  "repository": { "type": "git", "url": "git+https://github.com/lacspace/npm-packages.git", "directory": "lacspace-changelog" },
  "bugs": { "url": "https://github.com/lacspace/npm-packages/issues" },
  "engines": { "node": ">=20" },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": { "access": "public" }
}
