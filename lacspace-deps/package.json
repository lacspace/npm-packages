{
  "name": "lacspace-deps",
  "version": "0.2.0",
  "description": "Keyless dependency & licence auditor for Node/JS projects — licences, install size, duplicates, unused/missing deps and risky patterns, as a CI gate. Zero dependencies.",
  "type": "module",
  "bin": {
    "lacspace-deps": "dist/cli.js"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dependencies", "dependency-audit", "license-checker", "license-compliance",
    "spdx", "supply-chain", "unused-dependencies", "depcheck", "outdated",
    "install-size", "node-modules", "duplicates", "lockfile", "package-lock",
    "audit", "cli", "typescript", "zero-dependency", "sbom", "ci",
    "cyclonedx", "bom", "sbom-generator", "license-policy", "depsrc",
    "policy", "purl", "compliance"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/tools/deps",
  "repository": { "type": "git", "url": "git+https://github.com/lacspace/npm-packages.git", "directory": "lacspace-deps" },
  "bugs": { "url": "https://github.com/lacspace/npm-packages/issues" },
  "engines": { "node": ">=20" },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": { "access": "public" }
}
