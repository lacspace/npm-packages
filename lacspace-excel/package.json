{
  "name": "lacspace-excel",
  "version": "0.1.0",
  "description": "Excel Swiss-army knife — convert JSON/CSV to .xlsx and back, and generate ready-to-fill business templates (invoice, inventory, payroll, loan schedule, grade book…) with live formulas. Built on Lacspace's zero-dependency xlsx, csv and formula engines.",
  "type": "module",
  "bin": {
    "lacspace-excel": "dist/cli.js"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "excel", "xlsx", "json-to-excel", "excel-to-json", "csv-to-xlsx", "xlsx-to-csv",
    "spreadsheet", "converter", "excel-templates", "invoice-template", "inventory-template",
    "payroll-template", "formulas", "cli", "zero-dependency"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/tools/excel",
  "repository": { "type": "git", "url": "git+https://github.com/lacspace/npm-packages.git", "directory": "lacspace-excel" },
  "bugs": { "url": "https://github.com/lacspace/npm-packages/issues" },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@lacspace/xlsx": "^1.3.0",
    "@lacspace/csv": "^1.2.0",
    "@lacspace/formula": "^1.0.0",
    "@lacspace/convert": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": { "access": "public" }
}
