{
  "name": "lacspace-extract",
  "version": "0.2.0",
  "description": "Free, open-source data extraction — pull text, tables and metadata out of PDFs, Office docs (DOCX/PPTX/EPUB), HTML pages and spreadsheets into clean JSON, NDJSON, CSV, Excel or Markdown. Zero-dependency PDF text engine (no OCR) + ZIP reader, HTML readability, page ranges and grep. No API keys.",
  "type": "module",
  "bin": { "lacspace-extract": "dist/cli.js" },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": { "types": "./dist/lib.d.ts", "import": "./dist/lib.js", "require": "./dist/lib.cjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": { "build": "tsup", "test": "vitest run", "typecheck": "tsc --noEmit", "prepublishOnly": "npm run build" },
  "keywords": ["pdf", "pdf-text", "pdf-metadata", "docx", "pptx", "epub", "office", "zip", "table-extraction", "extract", "documents", "markdown", "readability", "csv", "excel", "html-tables", "data-extraction", "cli", "typescript"],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/tools/extract",
  "repository": { "type": "git", "url": "git+https://github.com/lacspace/npm-packages.git", "directory": "lacspace-extract" },
  "bugs": { "url": "https://github.com/lacspace/npm-packages/issues" },
  "engines": { "node": ">=20" },
  "dependencies": { "lacspace-scraper": "^0.1.0" },
  "devDependencies": { "@types/node": "^20.14.0", "tsup": "^8.0.0", "typescript": "^5.5.0", "vitest": "^2.0.0" },
  "publishConfig": { "access": "public" }
}
