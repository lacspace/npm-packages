{
  "name": "lacspace-fake",
  "version": "0.1.0",
  "description": "Keyless, deterministic fake / seed data generator — schema-driven rows to JSON, NDJSON, CSV or SQL INSERTs, with a Nepal locale. Zero dependencies.",
  "type": "module",
  "bin": {
    "lacspace-fake": "dist/cli.js"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "fake-data", "seed-data", "mock-data", "test-fixtures", "faker",
    "data-generator", "sql-insert", "csv", "ndjson", "json",
    "schema", "deterministic", "seeded-prng", "nepal", "npr",
    "database-seeding", "cli", "typescript", "zero-dependency", "lorem-ipsum",
    "uuid", "test-data"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/tools/fake",
  "repository": { "type": "git", "url": "git+https://github.com/lacspace/npm-packages.git", "directory": "lacspace-fake" },
  "bugs": { "url": "https://github.com/lacspace/npm-packages/issues" },
  "engines": { "node": ">=20" },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": { "access": "public" }
}
