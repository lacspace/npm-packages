{
  "name": "lacspace-har",
  "version": "0.2.0",
  "description": "Read a browser .har export offline — ASCII + HTML waterfalls, diff two HARs, performance budgets (CI gate), filters, savings-quantified recommendations, HAR-derived web-vitals estimates, redaction and CSV/JSON export. Zero dependencies.",
  "type": "module",
  "bin": {
    "lacspace-har": "dist/cli.js"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "har", "har-analyzer", "har-viewer", "har-diff", "waterfall", "performance",
    "web-performance", "performance-budget", "network", "devtools", "page-weight",
    "third-party", "web-vitals", "redact", "cli", "typescript"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/tools/har",
  "repository": { "type": "git", "url": "git+https://github.com/lacspace/npm-packages.git", "directory": "lacspace-har" },
  "bugs": { "url": "https://github.com/lacspace/npm-packages/issues" },
  "engines": { "node": ">=20" },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": { "access": "public" }
}
