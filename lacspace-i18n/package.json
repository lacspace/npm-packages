{
  "name": "lacspace-i18n",
  "version": "0.2.0",
  "description": "Find missing, unused and untranslated locale keys, diff locales, validate ICU MessageFormat, convert between JSON/YAML/.properties/gettext .po, and auto-sync translations — a keyless i18n linter. Zero dependencies.",
  "type": "module",
  "bin": {
    "lacspace-i18n": "dist/cli.js"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "i18n", "internationalization", "localization", "l10n", "translation",
    "locale", "translations", "missing-keys", "unused-keys", "icu",
    "icu-messageformat", "messageformat", "plural", "select", "interpolation",
    "json", "yaml", "properties", "gettext", "po", "convert", "format-conversion",
    "sync", "auto-sync", "coverage", "i18next", "vue-i18n", "react-intl",
    "cli", "typescript", "zero-dependency"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/tools/i18n",
  "repository": { "type": "git", "url": "git+https://github.com/lacspace/npm-packages.git", "directory": "lacspace-i18n" },
  "bugs": { "url": "https://github.com/lacspace/npm-packages/issues" },
  "engines": { "node": ">=20" },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": { "access": "public" }
}
