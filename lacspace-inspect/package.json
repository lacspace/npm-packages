{
  "name": "lacspace-inspect",
  "version": "0.2.0",
  "description": "One-command website audit — SEO, meta, Open Graph, structured data, headings, images, links, security headers and tech stack, graded A–F with concrete fix suggestions. Crawl a whole site, set performance budgets, diff against a baseline for CI, and export Markdown/HTML reports. No API keys. Built on the lacspace-scraper engine.",
  "type": "module",
  "bin": {
    "lacspace-inspect": "dist/cli.js"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "seo", "audit", "website-audit", "seo-checker", "lighthouse", "meta-tags",
    "open-graph", "structured-data", "json-ld", "security-headers", "accessibility",
    "broken-links", "ci", "grade", "cli", "typescript"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/tools/inspect",
  "repository": { "type": "git", "url": "git+https://github.com/lacspace/npm-packages.git", "directory": "lacspace-inspect" },
  "bugs": { "url": "https://github.com/lacspace/npm-packages/issues" },
  "engines": { "node": ">=20" },
  "dependencies": {
    "lacspace-scraper": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": { "access": "public" }
}
