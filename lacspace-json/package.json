{
  "name": "lacspace-json",
  "version": "0.1.0",
  "description": "The friendly jq — query, convert (JSON/YAML/TOML/CSV/NDJSON), validate, diff and merge structured data from a file, glob or stdin. Zero dependencies.",
  "type": "module",
  "bin": {
    "lacspace-json": "dist/cli.js"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "jq", "json", "yaml", "toml", "csv", "ndjson", "json-schema",
    "json-diff", "json-merge", "json-query", "jsonpath", "convert",
    "validate", "cli", "typescript", "zero-dependency", "data",
    "transform", "pretty-print", "minify", "stdin"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/tools/json",
  "repository": { "type": "git", "url": "git+https://github.com/lacspace/npm-packages.git", "directory": "lacspace-json" },
  "bugs": { "url": "https://github.com/lacspace/npm-packages/issues" },
  "engines": { "node": ">=20" },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": { "access": "public" }
}
