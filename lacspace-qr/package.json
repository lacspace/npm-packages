{
  "name": "lacspace-qr",
  "version": "0.2.0",
  "description": "Generate scannable QR codes to the terminal, SVG or PNG from a hand-written, spec-correct encoder — presets for URL, WiFi, vCard, email, SMS and geo, plus batch mode. Zero dependencies.",
  "type": "module",
  "bin": {
    "lacspace-qr": "dist/cli.js"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "qr", "qrcode", "qr-code", "qr-generator", "qrcode-generator",
    "reed-solomon", "svg", "png", "terminal", "ansi", "wifi-qr", "vcard",
    "barcode", "offline", "cli", "typescript", "zero-dependency",
    "no-dependencies", "isomorphic", "encoder", "ecc",
    "styled-qr", "qr-logo", "gradient", "dots", "rounded",
    "calendar", "ics", "vevent", "batch", "mailto", "geo"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/tools/qr",
  "repository": { "type": "git", "url": "git+https://github.com/lacspace/npm-packages.git", "directory": "lacspace-qr" },
  "bugs": { "url": "https://github.com/lacspace/npm-packages/issues" },
  "engines": { "node": ">=20" },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": { "access": "public" }
}
