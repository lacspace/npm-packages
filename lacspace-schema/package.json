{
  "name": "lacspace-schema",
  "version": "0.1.0",
  "description": "Infer a JSON Schema (draft-07) from data, generate TypeScript types from JSON or a schema, and build realistic examples from a schema. Zero dependencies.",
  "type": "module",
  "bin": {
    "lacspace-schema": "dist/cli.js"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "json-schema", "schema-inference", "infer-schema", "json-to-typescript",
    "typescript-types", "codegen", "type-generation", "draft-07",
    "json-to-schema", "schema-to-typescript", "quicktype", "json-schema-to-ts",
    "example-generator", "fixture", "cli", "typescript", "zero-dependency",
    "schema-diff", "ndjson", "type-inference"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/tools/schema",
  "repository": { "type": "git", "url": "git+https://github.com/lacspace/npm-packages.git", "directory": "lacspace-schema" },
  "bugs": { "url": "https://github.com/lacspace/npm-packages/issues" },
  "engines": { "node": ">=20" },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": { "access": "public" }
}
