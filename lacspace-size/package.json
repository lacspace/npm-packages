{
  "name": "lacspace-size",
  "version": "0.1.0",
  "description": "Measure build-output & bundle size as raw + gzip + brotli, enforce size budgets in CI, and diff against a saved baseline to catch regressions. Zero dependencies.",
  "type": "module",
  "bin": {
    "lacspace-size": "dist/cli.js"
  },
  "main": "./dist/lib.cjs",
  "module": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "require": "./dist/lib.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bundle-size", "size-limit", "gzip-size", "brotli-size", "bundle-analyzer",
    "size-budget", "dist-size", "build-size", "size-report", "size-diff",
    "baseline", "ci-gate", "regression", "compression", "gzip", "brotli",
    "cli", "typescript", "zero-dependency", "bundlesize", "file-size"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/tools/size",
  "repository": { "type": "git", "url": "git+https://github.com/lacspace/npm-packages.git", "directory": "lacspace-size" },
  "bugs": { "url": "https://github.com/lacspace/npm-packages/issues" },
  "engines": { "node": ">=20" },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": { "access": "public" }
}
