{
  "name": "@lacspace/market-clock",
  "version": "1.1.0",
  "description": "Holiday-aware, timezone-correct trading clock — is NSE/BSE/NYSE/LSE open now, current session segment, next open/close, half-days, next N sessions. Built-in exchange presets + bring your own spec. Zero-dependency.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "market-hours",
    "trading-hours",
    "stock-market",
    "nse",
    "bse",
    "market-open",
    "holidays",
    "exchange-calendar",
    "timezone",
    "typescript",
    "trading-clock",
    "market-status",
    "pre-open",
    "post-close",
    "session",
    "exchange-hours",
    "nyse",
    "nasdaq",
    "lse",
    "tse",
    "hkex",
    "sgx",
    "exchange-presets",
    "session-segment",
    "half-day",
    "early-close",
    "after-hours",
    "post-market",
    "next-sessions",
    "countdown",
    "dst"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/market-clock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "market-clock"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
