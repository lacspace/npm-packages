{
  "name": "@lacspace/paper-trade",
  "version": "1.2.0",
  "description": "Headless paper-trading engine — virtual wallet, market/limit/stop/stop-limit/trailing orders with time-in-force that fill against live price ticks, positions, realized & unrealized P&L, commission + slippage models and equity-curve analytics. The simulator core behind StockYatra. Zero-dependency.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "paper-trading",
    "trading-simulator",
    "stock-market",
    "virtual-trading",
    "backtesting",
    "portfolio",
    "order-book",
    "stockyatra",
    "pnl",
    "typescript",
    "trading-engine",
    "simulator",
    "virtual-portfolio",
    "stock-simulator",
    "charges",
    "trade-stats",
    "order-management",
    "stop-limit",
    "trailing-stop",
    "time-in-force",
    "slippage",
    "commission",
    "equity-curve",
    "drawdown",
    "process-tick"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/paper-trade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "paper-trade"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
