{
  "name": "@lacspace/password",
  "version": "1.1.0",
  "description": "Password hashing & verification — PBKDF2-HMAC-SHA256 (OWASP iterations) with a portable PHC string, a zxcvbn-style strength estimator, k-anonymity breach check, policy evaluator and cryptographic passphrase/password generators. Isomorphic over Web Crypto.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "password",
    "hash",
    "pbkdf2",
    "password-hashing",
    "verify",
    "phc",
    "auth",
    "security",
    "typescript",
    "argon2-alternative",
    "bcrypt-alternative",
    "password-verify",
    "owasp",
    "salt",
    "secure-password",
    "haveibeenpwned",
    "pwned",
    "breach-check",
    "k-anonymity",
    "password-strength",
    "zxcvbn",
    "entropy",
    "password-policy",
    "passphrase",
    "diceware",
    "password-generator"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/password",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "password"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lacspace/crypto": "^1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
