{
  "name": "@lacspace/postbandit",
  "version": "1.0.0",
  "description": "A tiny Thompson-sampling multi-armed bandit to learn the best option per platform — posting time, format (video/image/carousel/text), thumbnail or title variant — from engagement rewards. Beta posteriors per arm, deterministic when seeded, persistable to JSON, and designed to plug into @lacspace/postplan. Zero dependencies, isomorphic.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": { "build": "tsup", "prepublishOnly": "npm run build" },
  "keywords": [
    "bandit", "thompson-sampling", "multi-armed-bandit", "ab-testing", "optimization",
    "scheduling", "social-media", "newsroom", "zero-dependency", "typescript"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/postbandit",
  "repository": { "type": "git", "url": "git+https://github.com/lacspace/npm-packages.git", "directory": "postbandit" },
  "bugs": { "url": "https://github.com/lacspace/npm-packages/issues" },
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" }
}
