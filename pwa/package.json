{
  "name": "@lacspace/pwa",
  "version": "1.0.0",
  "description": "Turn any site into an installable Progressive Web App with zero dependencies — generate a production service worker (offline caching + web-push handlers) and a web app manifest, plus tiny browser helpers to register it and drive the install prompt. Framework-agnostic (Next.js, Vite, plain HTML).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pwa",
    "progressive-web-app",
    "service-worker",
    "web-manifest",
    "manifest",
    "offline",
    "installable",
    "add-to-home-screen",
    "web-push",
    "caching",
    "sw",
    "beforeinstallprompt",
    "zero-dependency",
    "nextjs",
    "vite",
    "isomorphic",
    "typescript"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/pwa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "pwa"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
