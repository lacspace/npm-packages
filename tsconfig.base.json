{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false
  },
  "exclude": ["**/dist", "**/node_modules", "lacspace-leads", "lacspace-scraper", "lacspace-monitor", "lacspace-enrich", "lacspace-extract", "lacspace-sql", "lacspace-inspect", "lacspace-dotenv", "lacspace-webhook", "lacspace-har", "lacspace-cron", "lacspace-icon"]
}
