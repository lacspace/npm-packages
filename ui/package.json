{
  "name": "@lacspace/ui",
  "version": "1.1.0",
  "description": "A tiny, dependency-free React kit that makes a page feel alive — scroll reveals, animated counters, gradient text, tilt cards, marquees, a typewriter and a ⌘K command palette — plus framework-agnostic helpers (easings, variant class builder, tilt/gradient math, command filter & scorer). No animation library, no CSS import. Respects prefers-reduced-motion; Tailwind-friendly.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "react-components",
    "animation",
    "scroll-reveal",
    "count-up",
    "gradient-text",
    "tilt",
    "marquee",
    "typewriter",
    "command-palette",
    "cmdk-alternative",
    "framer-motion-alternative",
    "prefers-reduced-motion",
    "tailwind",
    "nextjs",
    "typescript",
    "zero-dependency",
    "easing",
    "easing-functions",
    "class-variance",
    "classnames",
    "count-up-formatter",
    "fuzzy-search",
    "command-filter",
    "roving-tabindex"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "ui"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
