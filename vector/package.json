{
  "name": "@lacspace/vector",
  "version": "1.0.0",
  "description": "A tiny, zero-dependency in-memory vector store for RAG and semantic search — upsert records, brute-force k-nearest-neighbour query with cosine / dot / euclidean metrics, metadata filtering, and plain-JSON persistence. Isomorphic and fully typed.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vector",
    "vector-store",
    "vector-database",
    "vectordb",
    "embeddings",
    "semantic-search",
    "similarity-search",
    "nearest-neighbor",
    "knn",
    "cosine-similarity",
    "rag",
    "retrieval",
    "in-memory",
    "ai",
    "llm",
    "typescript",
    "zero-dependency",
    "isomorphic"
  ],
  "author": "Lacspace <contact@lacspace.com>",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://developer.lacspace.com/packages/vector",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacspace/npm-packages.git",
    "directory": "vector"
  },
  "bugs": {
    "url": "https://github.com/lacspace/npm-packages/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
